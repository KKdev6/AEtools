# Copy to keystore.properties (same folder) and fill in. keystore.properties is git-ignored.
# Keep the keystore file itself outside this project folder, and back it up together with
# these passwords: without them you can never publish an update to the same app.
storeFile=/Users/you/AEtools-keys/aetools-release.jks
storePassword=CHANGE_ME
keyAlias=aetools
keyPassword=CHANGE_ME
